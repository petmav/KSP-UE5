<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed replacement for UnityEngine.AnimationCurve (native in Unity).
       Assembly-CSharp's type references to UnityEngine.AnimationCurve are retargeted
       to KspUnityShim.AnimationCurve by AsmPatcher. Port of UnityPlayer.dll 2019.4.18f1
       (x64, mono, nondev) AnimationCurveTpl<float>, transcribed from disassembly. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KspUnityShim</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>..\..\build\KspUnityShim\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\..\lib\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
