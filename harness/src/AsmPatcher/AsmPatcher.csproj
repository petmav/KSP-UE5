<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time tool: copies Assembly-CSharp.dll and retargets its type references to
       UnityEngine.AnimationCurve (native-backed in Unity) to KspUnityShim.AnimationCurve.
       No method body, field, or other type is changed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\..\build\AsmPatcher\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
