{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug",
      "displayName": "x64 Debug (MSVC, Ninja)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/Debug"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "x64 RelWithDebInfo (MSVC, Ninja) -> build/RelWithDebInfo/kspcore.lib (Unreal bridge)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "binaryDir": "${sourceDir}/build/RelWithDebInfo"
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-rel",
      "displayName": "Linux Release (Clang if present, else GCC; Ninja)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/linux-rel"
    },
    {
      "name": "linux-dbg",
      "displayName": "Linux Debug (Clang if present, else GCC; Ninja)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/linux-dbg"
    },
    {
      "name": "linux-gcc-rel",
      "displayName": "Linux Release, GCC",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "binaryDir": "${sourceDir}/build/linux-gcc-rel"
    },
    {
      "name": "spike-jolt",
      "displayName": "Jolt physics spike, Release, Jolt DOUBLE_PRECISION (PHYSICS-SPIKE.md; no tests, fetches Jolt)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KSPCORE_BUILD_TESTS": "OFF",
        "KSPCORE_BUILD_SPIKES": "ON",
        "KSP_JOLT_DOUBLE": "ON"
      },
      "binaryDir": "${sourceDir}/build/spike-jolt"
    },
    {
      "name": "spike-jolt-f32",
      "displayName": "Jolt physics spike, Release, Jolt single precision (PHYSICS-SPIKE.md; no tests, fetches Jolt)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KSPCORE_BUILD_TESTS": "OFF",
        "KSPCORE_BUILD_SPIKES": "ON",
        "KSP_JOLT_DOUBLE": "OFF"
      },
      "binaryDir": "${sourceDir}/build/spike-jolt-f32"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "linux-rel",
      "configurePreset": "linux-rel"
    },
    {
      "name": "linux-dbg",
      "configurePreset": "linux-dbg"
    },
    {
      "name": "linux-gcc-rel",
      "configurePreset": "linux-gcc-rel"
    },
    {
      "name": "spike-jolt",
      "configurePreset": "spike-jolt"
    },
    {
      "name": "spike-jolt-f32",
      "configurePreset": "spike-jolt-f32"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-rel",
      "configurePreset": "linux-rel",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-dbg",
      "configurePreset": "linux-dbg",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-gcc-rel",
      "configurePreset": "linux-gcc-rel",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
