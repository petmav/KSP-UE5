<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Equivalent of the guide's "Properties -> Reference Paths" step: KSP mod-dev install (NOT the Steam install). -->
    <!-- Pin the game root explicitly so KSPBuildTools can never fall back to the Steam install (it did once, silently, when the symlinks were missing). -->
    <KSPBT_GameRoot>C:\Projects\KSP-UE5\decompiled\KSP-dev</KSPBT_GameRoot>
    <ReferencePath>C:\Projects\KSP-UE5\decompiled\KSP-dev\</ReferencePath>
  </PropertyGroup>
</Project>
